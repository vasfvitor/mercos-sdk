{
  // Emite só src/ para dist/. Os imports "./x.ts" viram "./x.js" por rewriteRelativeImportExtensions.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src"]
}
