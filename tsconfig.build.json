{
  // Emits only src/ into dist/. rewriteRelativeImportExtensions turns "./x.ts" imports into "./x.js".
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src"]
}
