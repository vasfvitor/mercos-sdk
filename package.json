{
  "name": "mercos-sdk",
  "version": "0.1.0",
  "description": "Unofficial TypeScript SDK for the Mercos integration API: native fetch, zero dependencies, pagination and throttling handled",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mercos",
    "meuspedidos",
    "sdk",
    "api",
    "pedidos",
    "b2b"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "test:live": "node --test --test-concurrency=1 \"test/live/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.ts\"",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "verify": "pnpm lint && pnpm check && pnpm spec:lint && pnpm test",
    "spec:fetch": "node scripts/fetch-spec.ts",
    "spec:merge": "node scripts/merge-spec.ts",
    "spec:types": "node scripts/gen-types.ts",
    "spec:fixtures": "node scripts/extract-fixtures.ts",
    "spec:lint": "node scripts/lint-spec.ts",
    "spec:check": "node scripts/check-spec.ts",
    "spec": "pnpm spec:fetch && pnpm spec:merge && pnpm spec:types && pnpm spec:fixtures && pnpm spec:check --update",
    "prepublishOnly": "pnpm verify && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@redocly/openapi-core": "^1.34.20",
    "@types/node": "^24",
    "openapi-typescript": "^7",
    "typescript": "^5.9"
  }
}
